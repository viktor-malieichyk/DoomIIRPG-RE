# SDL2 predates scene-based UIKit. Attach its window to our single scene.
set(SDL_UIKIT_WINDOW "${PROJECT_SOURCE_DIR}/build/ios-deps/SDL/src/video/uikit/SDL_uikitwindow.m")
file(READ "${SDL_UIKIT_WINDOW}" SDL_WINDOW_SOURCE)
string(REPLACE "uiwindow = [[SDL_uikitwindow alloc] initWithFrame:data.uiscreen.bounds];"
 "UIWindowScene *gameScene = nil;\n        for (UIScene *scene in UIApplication.sharedApplication.connectedScenes) {\n            if ([scene isKindOfClass:UIWindowScene.class]) { gameScene = (UIWindowScene *)scene; break; }\n        }\n        uiwindow = gameScene ? [[SDL_uikitwindow alloc] initWithWindowScene:gameScene] : [[SDL_uikitwindow alloc] initWithFrame:data.uiscreen.bounds];\n        uiwindow.frame = gameScene ? gameScene.coordinateSpace.bounds : data.uiscreen.bounds;"
 SDL_WINDOW_PATCHED "${SDL_WINDOW_SOURCE}")
string(REPLACE "uiwindow.frame = data.uiscreen.bounds;"
 "uiwindow.frame = gameScene ? gameScene.coordinateSpace.bounds : data.uiscreen.bounds;"
 SDL_WINDOW_PATCHED "${SDL_WINDOW_PATCHED}")
if(NOT SDL_WINDOW_PATCHED STREQUAL SDL_WINDOW_SOURCE)
 file(WRITE "${SDL_UIKIT_WINDOW}" "${SDL_WINDOW_PATCHED}")
endif()
set(SDL_SHARED OFF CACHE BOOL "" FORCE)
set(SDL_STATIC ON CACHE BOOL "" FORCE)
set(SDL_TEST OFF CACHE BOOL "" FORCE)
set(SDL2_DISABLE_INSTALL ON CACHE BOOL "" FORCE)
add_subdirectory(build/ios-deps/SDL ${CMAKE_BINARY_DIR}/SDL)
set(HASH_LIBRARY_TGT_NAME Hash-Library)
add_subdirectory(third_party_libs/hash-library)
file(GLOB GAME_SOURCES CONFIGURE_DEPENDS ${PROJECT_SOURCE_DIR}/src/*.cpp)
add_executable(${PROJECT_NAME} MACOSX_BUNDLE ${GAME_SOURCES} ios/Entry.m ios/Platform.m ios/SaveArchive.m ios/ImportData.c ios/Viewport.c ios/Assets.xcassets)
set_target_properties(${PROJECT_NAME} PROPERTIES CXX_STANDARD 17 CXX_STANDARD_REQUIRED YES)
target_compile_definitions(${PROJECT_NAME} PRIVATE DOOMRPG_IOS=1 GLES_SILENCE_DEPRECATION=1)
target_include_directories(${PROJECT_NAME} BEFORE PRIVATE src ios ios/compat build/ios-deps/SDL/src/video/uikit)
target_compile_options(${PROJECT_NAME} PRIVATE -fsigned-char "$<$<COMPILE_LANGUAGE:OBJC>:-fobjc-arc>")
target_link_libraries(${PROJECT_NAME} PRIVATE SDL2::SDL2-static Hash-Library z "-framework OpenAL" "-framework OpenGLES" "-framework UIKit" "-framework AVFAudio" "-framework UniformTypeIdentifiers")
set(DOOMRPG_BUNDLE_ID "org.doomrpg.doom2" CACHE STRING "Unique app identifier for Personal Team signing")
set_target_properties(${PROJECT_NAME} PROPERTIES MACOSX_BUNDLE_GUI_IDENTIFIER "${DOOMRPG_BUNDLE_ID}" MACOSX_BUNDLE_INFO_PLIST "${PROJECT_SOURCE_DIR}/ios/Info.plist" XCODE_ATTRIBUTE_TARGETED_DEVICE_FAMILY "1,2" XCODE_ATTRIBUTE_CODE_SIGN_STYLE Automatic XCODE_ATTRIBUTE_ASSETCATALOG_COMPILER_APPICON_NAME AppIcon XCODE_ATTRIBUTE_PRODUCT_BUNDLE_IDENTIFIER "${DOOMRPG_BUNDLE_ID}")
set_source_files_properties(ios/Assets.xcassets PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
configure_file(build/ios-deps/SDL/LICENSE.txt ${CMAKE_BINARY_DIR}/SDL-LICENSE.txt COPYONLY)
target_sources(${PROJECT_NAME} PRIVATE ${CMAKE_BINARY_DIR}/SDL-LICENSE.txt)
set_source_files_properties(${CMAKE_BINARY_DIR}/SDL-LICENSE.txt PROPERTIES MACOSX_PACKAGE_LOCATION Resources)

configure_file(LICENSE ${CMAKE_BINARY_DIR}/Game-LICENSE.txt COPYONLY)
target_sources(${PROJECT_NAME} PRIVATE ${CMAKE_BINARY_DIR}/Game-LICENSE.txt ios/CREDITS.txt)
set_source_files_properties(${CMAKE_BINARY_DIR}/Game-LICENSE.txt ios/CREDITS.txt PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
